REACT_EDITOR=code

APP_ENV=DEVELOPMENT
NEXT_PUBLIC_BACKEND_URL="http://localhost:8000/api"

# Use typed demonstration data when the weed-identification backend is
# unreachable during local development. Production builds never use it.
NEXT_PUBLIC_WEED_MOCK_FALLBACK=true

# Set to true only when demonstrating the frontend without the Django backend.
NEXT_PUBLIC_USE_WEED_MOCK=false
